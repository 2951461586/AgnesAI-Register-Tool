# 复制为 .env 后填入真实值：cp .env.example .env
# .env 已被 .gitignore 排除，不会进仓库。
# 也可以直接用环境变量传入 —— 环境变量优先级高于 .env。

# ── CF Worker 临时邮箱（必填）─────────────────────────────────────
# 复用 Intern-Register-Tool 那台 Worker（实测可收 Agnes 的验证码邮件：
# 发件人 `noreply@agnes-ai.com`，主题 `Your Agnes Platform Verification Code`，
# Worker 侧已配好规则，直接返回 `extracted_type="code"` 的 6 位码）。
#
# 🔴 为什么这三项没有默认值：本仓库是公开的，写死等于把邮箱服务的
#    管理凭据 + 自有域名一起交出去。缺了会在**启动阶段**报错（config.validate），
#    而不是带着空 base 去发一堆注定失败的请求。
AR_WORKER_BASE=
AR_WORKER_ADMIN_TOKEN=
AR_WORKER_DOMAIN=

# ── 收信域名池（域名轮换）─────────────────────────────────────────
# 🔴 Agnes 有**两道**限流：一道按 **IP**，一道按**收信域名**。多出口只解决
#    IP 那一半，另一半要靠**换域名** —— 所以这是与 `AR_PROXY_SLOTS` 并列的
#    **第二个吞吐杠杆**。只加出口不加域名会撞域名窗口，反之亦然。
#
# 逗号分隔。留空则退回 `AR_WORKER_DOMAIN`（单个）。
#
# 🔴 **域名数是吞吐的硬上限** —— 域名维度 2 格 = 1 个账号，所以 4 个可用域名
#    = 4 个账号/小时（配 `AR_DOMAIN_MAX_PER_WINDOW=4` 则翻倍）。
#
# ⚠ 平台侧有**域名白名单**（实测 10-13 首测 / 10-14 复测）：
#     允许：own.example / sub.own.example / own2.example / own3.example
#     明确拒：own4.example / own5.example / own6.example
#            → `400 This email domain looks invalid or abusive ...`
#   把被拒的域名加进来只会拿到确定性的 `rejected`，**还会白烧一格 IP 窗口**。
#   换池前先跑 `tools/probes/probe_domains.py`（⚠ 消耗注册窗口）。
# AR_MAIL_DOMAINS=own.example,sub.own.example,own2.example,own3.example

# ── 邮箱源（**多源**）────────────────────────────────────────────
# 🔴 服务端的注册限流有一道**按收信域名**的窗口 ⇒ "有多少个可用域名"直接决定
#    每小时能跑几个账号。而**单个源能给的域名数有限**（自有域名只有 4 个可用），
#    所以**第二个源是唯一能加域名窗口的手段**。
#
#   worker    = 自有 CF Worker 域名（上面的 AR_MAIL_DOMAINS）
#               —— 独占窗口、可预测
#   catchmail = catchmail.io 公共临时邮箱（**免鉴权**，无需凭据）
#               —— 额外 3 个域名（catchmail.io / mailistry.com / zeppost.com）
#
# ⚠ 默认只有 worker —— **换源是显式动作**。
# 🔴 catchmail 的域名是**公共**的：任何人都能在上面建地址 ⇒ 那个域名的服务端
#    窗口**与陌生人共享**，可能被别人的量打满且**不可控**。定位是"补充窗口"，
#    不是替代自有域名。
#    实测（2026-10-14）：3 个域名**全过** Agnes 白名单，端到端 **2s 收到验证码**。
# AR_MAIL_SOURCES=worker
# AR_MAIL_SOURCES=worker,catchmail
# AR_MAIL_SOURCES=worker,catchmail,smailr
# 覆盖 catchmail 的域名（留空 = 用内置的 3 个）
# AR_CATCHMAIL_DOMAINS=

# ── smailr 邮箱源（第三个源；域名最多）──────────────────────────
# 🔴 它给 **4 个**域名，实测**全部过** Agnes 白名单 ⇒ 域名池 7 → 11。
#    （catchmail 只给 3 个，所以它是三个源里最值的。）
#
# ⚠ **账号等级是硬门**：不传 `domain_id` 时用账号的**默认域名**，而它可能要求
#    更高等级（实测：`403 该域名要求用户等级 4 及以上，您当前等级为 2`）。
#    ⇒ 后台要把「邮箱域名」设成下面 4 个之一（它们是**等级 1** 就能用的）。
# ⚠ API **不可枚举**域名（`/domains` 与 `/settings/domains` 都是 403），
#    所以非默认域名的 `domain_id` 只能从后台人工拿。
# 🔴 撞到等级 403 时它会**复用已有邮箱**（挑同域名、未归档、邮件最少的）——
#    所以即使建不了新的，只要有现成的就能继续跑。
# 🔴 它**成功落库后会删掉对应邮箱**（`AR_SMAILR_DELETE_AFTER_SUCCESS`，默认开）：
#    账号有**邮箱总数上限**（实测 `mailbox_limit=100`），不删跑几十个就卡死。
# AR_SMAILR_API_KEY=nm_...
# AR_SMAILR_BASE=https://smailr.com
# 等级 1 就能用的 4 个域名（留空 = 用这 4 个）
# AR_SMAILR_DOMAINS=smailr.com,loc.cc,mail.nodeloc.cc,nodeloc.cc
# 后台里设的那个默认域名 —— 它是唯一可以省略 domain_id 的
# AR_SMAILR_DEFAULT_DOMAIN=smailr.com
# 非默认域名的 domain_id（写法：域名=id,域名2=id2）
# AR_SMAILR_DOMAIN_IDS=
# AR_SMAILR_DELETE_AFTER_SUCCESS=1

# ── Agnes 站点（一般不用改）───────────────────────────────────────
# 业务 API 在 platform-backend，浏览器页面在 platform（Origin / Referer 指它）。
# AR_PLATFORM_BASE=https://platform-backend.agnes-ai.com
# AR_CONSOLE_BASE=https://platform.agnes-ai.com
# 推理网关（API Key 只在这里有效，OpenAI 兼容）。
# AR_APIHUB_BASE=https://apihub.agnes-ai.com/v1

# ── 注册资料 ──────────────────────────────────────────────────────
# 密码长度（>= 8，服务端硬要求 `Password must be at least 8 characters`）。
# AR_PASSWORD_LEN=16
# 创建的 API Key 名称。
# AR_KEY_NAME=auto

# ── Key 校验（推理网关侧）─────────────────────────────────────────
# 校验用的模型与是否真的打一次 chat/completions。
# AR_VERIFY_MODEL=agnes-2.5-flash
# AR_VERIFY_CHAT=1

# ── 本地注册配额保护 ──────────────────────────────────────────────
# 🔴 这是**爆炸半径上限**（防“手滑跑 500 个”），不是服务端配额 ——
#    真正的限流是**服务端的两道窗口**（按 IP + 按收信域名，见下面的 AR_REGISTER_*）。
#    换机器 / 删 state/ 即重置。
# AR_REG_QUOTA_MAX=30
# AR_REG_QUOTA_WINDOW_H=24
# 计数文件路径（默认 state/register_quota.jsonl）。主要给自检脚本做隔离，
# 平时不用设。
# AR_QUOTA_STATE=

# ── 行为参数（一般不用改）─────────────────────────────────────────
# 收信轮询间隔。实测 Agnes 的验证码邮件在发信后 **1~3s** 到达，
# 而单次 `/api/inbox` 往返约 0.3~0.6s。
# AR_MAIL_POLL_INTERVAL=0.8
# AR_MAIL_POLL_TIMEOUT=120
# 建地址失败后的重试次数（**只对连接类错误与 5xx**，4xx 不重试）。
# 🔴 实测：5 个生产者并发打 Worker 时 Cloudflare 会掉连接
#    （10054 / RemoteDisconnected），不重试就直接丢一个账号。
# AR_MAIL_RETRIES=2
# AR_REQUEST_TIMEOUT=30
# AR_VERIFY_TIMEOUT=60

# ── 注册尝试限流（🔴 按 IP + 按收信域名，覆盖 /api/verification 与 /api/user/register）──
# 实测：同一出口连打会返回
#   400 {"code":400,"message":"Too many registration attempts from this IP.
#        Please try again later"}
# 且**两个端点共用同一张计数**；`login` 不受影响。
#
# ⚠ **窗口长度尚未测准** —— 唯一真源是 docs/protocol.md §3，
#    **本文件刻意不重复那个数字**（曾漂移成三处互不相同的值）。
#    所以本地闸门取保守值（3600s），**按出口分桶**（每个出口各有一张窗口）。
#    撞到服务端消息时会自动换出口 / 退避重试。
#
# 🔴 **单位是「请求」，不是一个账号一枪**：发码 + 注册共用同一张计数，
#    所以 **2 次 = 1 个账号**。想跑 N 个账号就把这里调成 ≥ 2N。
#    （曾把 2 读成"2 个账号"，而实际只能跑 1 个。）
# AR_REGISTER_MAX_PER_WINDOW=2
# AR_REGISTER_WINDOW_S=3600
# AR_REGISTER_RETRIES=3

# ── 域名维度的窗口（与 IP 维度**分开配**）──────────────────────────
# 🔴 实测：用**全新的出口 IP** 打已被用过的域名（`own.example`）仍然命中
#    `400 Too many registration attempts from this email domain. ...`
#    ⇒ 它**不是**按 IP 计的，换出口解决不了，只能换域名（AR_MAIL_DOMAINS）。
# 长度未知，取与 IP 维度同样的保守值。与 IP 维度分开配，是因为两者的真实
# 长度未必相同 —— 合成一个数会让“调 IP 的”顺手把域名的也改了。
#
# 🔴 同上：**2 次 = 1 个账号**。而且域名维度**换不动**（注册时域名已定死在
#    邮箱里），所以本地会先确认装得下**两枪**才发码 —— 装不下就一枪不发
#    （`skipped`），避免"码烧了、注册进不去"。
# AR_DOMAIN_MAX_PER_WINDOW=2
# AR_DOMAIN_WINDOW_S=3600

# 本地闸门「等不起就换维度」的阈值（秒）。
# 🔴 两道窗口都可能是**小时级**的，抱着闸门 sleep 会把批量拖死；超过这个
#    时长就不等了 —— 换出口 / 换域名（换不动才封顶退避）。
# AR_LIMITER_MAX_WAIT_S=20

# ── 出口代理（可选）───────────────────────────────────────────────
# 只有 Agnes 控制台侧需要时可挂；邮箱 Worker 默认直连（CF Worker 不关心我们的出口 IP）。
#   AR_PROXY=host:port:user:pass
#   AR_PROXY=http://user:pass@host:port
# AR_PROXY=
# 收信轮询是否也走代理（默认否）。轮询是整链瓶颈，绕代理只会更慢。
# AR_PROXY_MAIL=0

# ── 槽位代理池（多出口并发）────────────────────────────────
# 🔴 这是本项目的**并发杠杆**：注册尝试限流是**按 IP** 的，所以每个出口
#    各自有一张窗口 —— 只调大 --producers 是没用的（那是同一张窗口里的名额）。
#
# 槽位实例可以复用 Intern-Register-Tool 的
#   python tools/ops/proxypool_ctl.py start
# 体检：
#   python tools/probes/probe_slots.py
#
# 文件里一行一个或逗号分隔都行，`#` 开头是注释。
# AR_PROXY_SLOTS=http://127.0.0.1:7901,http://127.0.0.1:7902
# AR_PROXY_SLOTS_FILE=.slots.txt
# 等一个空闲出口最多等多久（秒）。全忙时 acquire() 会阻塞，超时按 network 记。
# AR_PROXY_SLOT_TIMEOUT=240
