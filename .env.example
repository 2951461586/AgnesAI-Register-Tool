# 复制为 .env 后填入真实值：cp .env.example .env
# .env 已被 .gitignore 排除，不会进仓库。
# 也可以直接用环境变量传入 —— 环境变量优先级高于 .env。

# ── CF Worker 临时邮箱（必填）─────────────────────────────────────
# 复用 Intern-Register-Tool 那台 Worker（实测可收 Agnes 的验证码邮件：
# 发件人 `noreply@agnes-ai.com`，主题 `Your Agnes Platform Verification Code`，
# Worker 侧已配好规则，直接返回 `extracted_type="code"` 的 6 位码）。
#
# 🔴 为什么这三项没有默认值：本仓库是公开的，写死等于把邮箱服务的
#    管理凭据 + 自有域名一起交出去。缺了会在**启动阶段**报错（config.validate），
#    而不是带着空 base 去发一堆注定失败的请求。
AR_WORKER_BASE=
AR_WORKER_ADMIN_TOKEN=
AR_WORKER_DOMAIN=

# ── 收信域名池（域名轮换）─────────────────────────────────────────
# 🔴 Agnes 有**两道**限流：一道按 **IP**，一道按**收信域名**。多出口只解决
#    IP 那一半，另一半要靠**换域名** —— 所以这是与 `AR_PROXY_SLOTS` 并列的
#    **第二个吞吐杠杆**。只加出口不加域名会撞域名窗口，反之亦然。
#
# 逗号分隔。留空则退回 `AR_WORKER_DOMAIN`（单个）。
# ⚠ 平台侧还有**域名白名单**（实测 own.example / sub.own.example /
#    own2.example 允许；own4.example 等被拒）。换池前先跑
#    `tools/probes/probe_domains.py`（⚠ 消耗注册窗口）。
# AR_MAIL_DOMAINS=own.example,sub.own.example

# ── Agnes 站点（一般不用改）───────────────────────────────────────
# 业务 API 在 platform-backend，浏览器页面在 platform（Origin / Referer 指它）。
# AR_PLATFORM_BASE=https://platform-backend.agnes-ai.com
# AR_CONSOLE_BASE=https://platform.agnes-ai.com
# 推理网关（API Key 只在这里有效，OpenAI 兼容）。
# AR_APIHUB_BASE=https://apihub.agnes-ai.com/v1

# ── 注册资料 ──────────────────────────────────────────────────────
# 密码长度（>= 8，服务端硬要求 `Password must be at least 8 characters`）。
# AR_PASSWORD_LEN=16
# 创建的 API Key 名称。
# AR_KEY_NAME=auto

# ── Key 校验（推理网关侧）─────────────────────────────────────────
# 校验用的模型与是否真的打一次 chat/completions。
# AR_VERIFY_MODEL=agnes-2.5-flash
# AR_VERIFY_CHAT=1

# ── 本地注册配额保护 ──────────────────────────────────────────────
# 🔴 这是**爆炸半径上限**（防“手滑跑 500 个”），不是服务端配额 ——
#    真正的限流是**服务端的两道窗口**（按 IP + 按收信域名，见下面的 AR_REGISTER_*）。
#    换机器 / 删 state/ 即重置。
# AR_REG_QUOTA_MAX=30
# AR_REG_QUOTA_WINDOW_H=24
# 计数文件路径（默认 state/register_quota.jsonl）。主要给自检脚本做隔离，
# 平时不用设。
# AR_QUOTA_STATE=

# ── 行为参数（一般不用改）─────────────────────────────────────────
# 收信轮询间隔。实测 Agnes 的验证码邮件在发信后 **1~3s** 到达，
# 而单次 `/api/inbox` 往返约 0.3~0.6s。
# AR_MAIL_POLL_INTERVAL=0.8
# AR_MAIL_POLL_TIMEOUT=120
# AR_REQUEST_TIMEOUT=30
# AR_VERIFY_TIMEOUT=60

# ── 注册尝试限流（🔴 按 IP + 按收信域名，覆盖 /api/verification 与 /api/user/register）──
# 实测：同一出口连打会返回
#   400 {"code":400,"message":"Too many registration attempts from this IP.
#        Please try again later"}
# 且**两个端点共用同一张计数**；`login` 不受影响。
#
# ⚠ **窗口长度尚未测准**（唯一真源：docs/protocol.md §3，已知 > 45 分钟）。
#    所以本地闸门取保守值（3600s），**按出口分桶**（每个出口各有一张窗口）。
#    撞到服务端消息时会自动换出口 / 退避重试。
# AR_REGISTER_MAX_PER_WINDOW=2
# AR_REGISTER_WINDOW_S=3600
# AR_REGISTER_RETRIES=3

# ── 域名维度的窗口（与 IP 维度**分开配**）──────────────────────────
# 🔴 实测：用**全新的出口 IP** 打已被用过的域名（`own.example`）仍然命中
#    `400 Too many registration attempts from this email domain. ...`
#    ⇒ 它**不是**按 IP 计的，换出口解决不了，只能换域名（AR_MAIL_DOMAINS）。
# 长度未知，取与 IP 维度同样的保守值。与 IP 维度分开配，是因为两者的真实
# 长度未必相同 —— 合成一个数会让“调 IP 的”顺手把域名的也改了。
# AR_DOMAIN_MAX_PER_WINDOW=2
# AR_DOMAIN_WINDOW_S=3600

# 本地闸门「等不起就换维度」的阈值（秒）。
# 🔴 两道窗口都可能是**小时级**的，抱着闸门 sleep 会把批量拖死；超过这个
#    时长就不等了 —— 换出口 / 换域名（换不动才封顶退避）。
# AR_LIMITER_MAX_WAIT_S=20

# ── 出口代理（可选）───────────────────────────────────────────────
# 只有 Agnes 控制台侧需要时可挂；邮箱 Worker 默认直连（CF Worker 不关心我们的出口 IP）。
#   AR_PROXY=host:port:user:pass
#   AR_PROXY=http://user:pass@host:port
# AR_PROXY=
# 收信轮询是否也走代理（默认否）。轮询是整链瓶颈，绕代理只会更慢。
# AR_PROXY_MAIL=0

# ── 槽位代理池（多出口并发）────────────────────────────────
# 🔴 这是本项目的**并发杠杆**：注册尝试限流是**按 IP** 的，所以每个出口
#    各自有一张窗口 —— 只调大 --producers 是没用的（那是同一张窗口里的名额）。
#
# 槽位实例可以复用 Intern-Register-Tool 的
#   python tools/ops/proxypool_ctl.py start
# 体检：
#   python tools/probes/probe_slots.py
#
# 文件里一行一个或逗号分隔都行，`#` 开头是注释。
# AR_PROXY_SLOTS=http://127.0.0.1:7901,http://127.0.0.1:7902
# AR_PROXY_SLOTS_FILE=.slots.txt
# 等一个空闲出口最多等多久（秒）。全忙时 acquire() 会阻塞，超时按 network 记。
# AR_PROXY_SLOT_TIMEOUT=240
